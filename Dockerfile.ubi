FROM registry.access.redhat.com/ubi9/nodejs-22

WORKDIR /opt/app-root/src

# Install pnpm
RUN npm install -g pnpm@9

# Copy package manifests for dependency caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY apps/docs/package.json apps/docs/
COPY packages/server/package.json packages/server/
COPY packages/agent-core/package.json packages/agent-core/
COPY packages/agent-catalog/package.json packages/agent-catalog/
COPY packages/auth/package.json packages/auth/
COPY packages/browser/package.json packages/browser/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/llm-provider/package.json packages/llm-provider/
COPY packages/mcp-client/package.json packages/mcp-client/
COPY packages/memory/package.json packages/memory/
COPY packages/skills/package.json packages/skills/
COPY packages/tasks/package.json packages/tasks/
COPY packages/tool-host/package.json packages/tool-host/
COPY packages/tools/package.json packages/tools/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json packages/ui/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy all source code
COPY . .

# Build the monorepo (turbo handles build order)
RUN pnpm run build

# Create writable data directory
USER 0
RUN mkdir -p /opt/app-root/data && \
    chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root
USER 1001

# Environment configuration
ENV NODE_ENV=production
ENV OPENACME_DATA_DIR=/opt/app-root/data
ENV OPENACME_HOST=0.0.0.0
ENV OPENACME_PORT=3456

EXPOSE 3456

CMD ["node", "packages/server/dist/index.js"]
