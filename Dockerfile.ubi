FROM registry.access.redhat.com/ubi9/nodejs-22

WORKDIR /opt/app-root/src

# Install pnpm as root, then fix permissions for the build
USER 0
RUN npm install -g pnpm@9

# Copy all source code first (simpler for monorepo with many workspace packages)
COPY . .

# Fix permissions so non-root can write node_modules in all workspace dirs
RUN chgrp -R 0 /opt/app-root/src && chmod -R g=u /opt/app-root/src
USER 1001

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the monorepo (turbo handles build order)
RUN pnpm run build

# Create writable data directory and config for runtime
USER 0
RUN mkdir -p /opt/app-root/data && \
    echo 'server:' > /opt/app-root/data/config.yaml && \
    echo '  host: "0.0.0.0"' >> /opt/app-root/data/config.yaml && \
    echo '  port: 3456' >> /opt/app-root/data/config.yaml && \
    chgrp -R 0 /opt/app-root/data && chmod -R g=u /opt/app-root/data
USER 1001

# Environment configuration
ENV NODE_ENV=production
ENV OPENACME_DATA_DIR=/opt/app-root/data

EXPOSE 3456

CMD ["node", "packages/server/dist/index.js"]
